{
  "title" : "Grainsize of surface samples collected from the reef flat physiographic zone of Wistari Reef",
  "description" : "Wistari Reef is a lagoonal platform reef, situated on the Tropic of Capricorn, within the Capricorn and Bunker region of the southern Great Barrier Reef. Five surface samples were taken from the reef flats and analysed to determine mean grainsize and the sorting coefficient (expressed as the standard deviation of grainsize) within each sample. The reef flat features moderately well-sorted coarse to very coarse sand, and can be divided into two sub-groups: the windward reef flats (samples S62 and S61) and the leeward reef flats (samples S24, S25 and S02).",
  "extent" : {
    "bbox" : [ [ 151.86952, -23.49043, 151.90253, -23.45359 ], [ 151.86952, -23.49043, 151.90253, -23.45359 ] ],
    "temporal" : [ [ "1997-12-31T13:00:00Z", "1998-12-31T12:59:59Z" ], [ "1997-12-31T13:00:00Z", "1998-12-31T12:59:59Z" ] ]
  },
